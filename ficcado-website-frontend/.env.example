# =============================================================================
# Ficcado Clothings — Environment Variables Example
# Duplicate this file to .env.local for local development, or configure in Netlify UI
# =============================================================================

# 1. WhatsApp Ordering (Official Line)
# International format digits only (no +, no dashes, no spaces)
# Example: 919497144795
NEXT_PUBLIC_WHATSAPP_NUMBER=919497144795

# 2. Public Storefront URL (Required for canonical URLs & OG metadata)
NEXT_PUBLIC_SITE_URL=https://ficcado.store

# 3. Google Sheets Database (Target Spreadsheet: 1U1bdFZH68Seg3OcV3Wtucmsqg8JL5i3MIGECglu_hfs)
GOOGLE_SHEET_ID=1U1bdFZH68Seg3OcV3Wtucmsqg8JL5i3MIGECglu_hfs

# Google Cloud Service Account Authentication
GOOGLE_SERVICE_ACCOUNT_EMAIL=ficcado-quick-webapp@ficcado-quick-website.iam.gserviceaccount.com
# Multi-line PEM or \n-escaped private key string
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional local path to service account key file (fallback for local dev)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=../credentials/ficcado-quick-website-5fc91a2f02ba.json

# 4. System & Operational Settings
ORDER_ID_LIMIT=9999
SHEETS_STRICT=false
ADMIN_TOKEN=ficcado-admin-secure-token
